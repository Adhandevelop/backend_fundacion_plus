# Configuración de entorno para Backend PLUS (Corporación Pluralismo Social)
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de Datos: usa 'postgresql' o 'postgis' para PostgreSQL/PostGIS, o 'sqlite3' para desarrollo rápido/CI
DB_ENGINE=postgresql
DB_NAME=plus_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS para Angular
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Correo saliente (Resend SMTP) y recuperación de contraseña
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=CLAVE_REAL_CONFIGURADA_EN_EL_SERVIDOR
DEFAULT_FROM_EMAIL=PLUS <notificaciones@fundacionplus.site>
EMAIL_TIMEOUT=15

FRONTEND_URL=https://fundacionplus.site
PASSWORD_RESET_TIMEOUT=3600
